# Basketball TITAN secure connection contract
# DO NOT store the real API credential in this file or in Git.
# Configure THE_ODDS_API_KEY as a Render secret/environment variable.

THE_ODDS_API_KEY=__RENDER_SECRET_REQUIRED__
BASKETBALL_ODDS_REGIONS=us
BASKETBALL_PRIMARY_SOURCE=sofascore
BASKETBALL_VERIFY_SOURCE=espn
BASKETBALL_DATA_INTERVAL_SECONDS=60
BASKETBALL_MARKET_INTERVAL_SECONDS=60
BASKETBALL_RESULT_INTERVAL_SECONDS=300
BASKETBALL_TOTAL_MIN_EDGE=0.055
BASKETBALL_LOW_LINE_OVER_THRESHOLD=160
BASKETBALL_LOW_LINE_OVER_PENALTY=0.025
BASKETBALL_TOTAL_LINE_SENSITIVITY_STEP=2.5
BASKETBALL_TOTAL_MAX_LINE_FRAGILITY=0.085
BASKETBALL_TOTAL_OPPONENT_FLOOR_RATIO=0.90
BASKETBALL_MEMORY_DB=basketball_titan.db
BASKETBALL_HISTORICAL_DATASET=data/basketball/pregame.jsonl
BASKETBALL_MEMORY_RAW_LIMIT=250
BASKETBALL_MEMORY_MARKET_LIMIT=500
BASKETBALL_MEMORY_VERIFIED_LIMIT=250
